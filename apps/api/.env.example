# --- App -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Front-end URL (used for Stripe success/cancel/portal redirects)
APP_URL=http://localhost:5173
# Comma-separated list of allowed origins for CORS (* is refused in production).
# Also used as Clerk authorizedParties (together with APP_URL). The web calls the API through its same-origin
# /api proxy, so CORS only matters for direct cross-origin clients (other domains, mobile, tools).
CORS_ORIGINS=http://localhost:5173
# Optional: anchored regex of extra origins allowed to use session tokens, for preview deployments, e.g.
# ^https://myapp-web-[a-z0-9-]+-myteam\.vercel\.app$
AUTHORIZED_PARTY_PATTERN=
# Optional: header with the real client IP for rate limiting, only when a proxy you control overwrites it
# (e.g. cf-connecting-ip behind Cloudflare, x-real-ip behind your nginx). Default: x-real-ip/x-forwarded-for
# on Vercel (VERCEL is set by the platform); the socket address anywhere else (self-hosted).
CLIENT_IP_HEADER=
# Same value in the web project: the web proxy (/api) forwards the visitor IP signed with it, so anonymous
# rate limits are per visitor, not per proxy. At least 16 chars: openssl rand -hex 32
API_PROXY_SECRET=
# "debug" logs diagnostics such as the source of the client IP (check it once after deploying)
LOG_LEVEL=info
# Production refuses to start without Upstash Redis (rate limiting). Set to true ONLY to run without it.
RATE_LIMIT_DISABLED=
# Secret for Vercel Cron (GET /cron/retention, see vercel.json) and detailed GET /health
# (Authorization: Bearer <CRON_SECRET>). At least 16 chars: openssl rand -hex 32
CRON_SECRET=

# --- Cloudflare Turnstile (bot check on the public contact form) --------------
# Cloudflare dashboard > Turnstile > Add widget (hostnames: your domain; add vercel.app for previews).
# Required in production unless TURNSTILE_DISABLED=true. Test secret (always passes): 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
TURNSTILE_DISABLED=
# Hostnames a token may come from (subdomains included), comma-separated. Empty = the APP_URL hostname.
TURNSTILE_ALLOWED_HOSTNAMES=

# --- Neon (PostgreSQL) -----------------------------------------------------
# LOCAL .env: the pooled URL of the Neon "dev" BRANCH (never production). Production uses the main branch and
# is only touched by the deploy (Vercel env + migrations in the build). Previews: Neon-Vercel integration
# (one Neon branch per preview, DATABASE_URL injected automatically).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Direct (non-pooled) URL used by the migration in the Vercel build. The Neon-Vercel integration sets it; if
# empty, the build derives it from DATABASE_URL by removing "-pooler".
DATABASE_URL_UNPOOLED=
# Host of the PRODUCTION endpoint without "-pooler" (not a secret; set in every Vercel environment). Previews
# and development refuse to run against it, and the build migration checks it.
PRODUCTION_DATABASE_HOST=
# Preview builds migrate their own Neon branch only when "true" (and PRODUCTION_DATABASE_HOST is set).
MIGRATE_PREVIEW=

# --- Clerk -----------------------------------------------------------------
# Clerk dashboard > API Keys (sk_test_... / pk_test_...)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Optional (recommended in production): Clerk > API keys > "JWT public key" (PEM). Verifies session tokens
# locally (networkless), so a cold start does not fetch Clerk's JWKS first. Paste with real or escaped newlines.
CLERK_JWT_KEY=
# Optional: Clerk > Webhooks > Add endpoint <API_URL>/webhooks/clerk (user.created, user.updated, user.deleted)
# > Signing secret (whsec_...). Keeps the users table in sync and erases data on account deletion (LGPD).
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Cloudflare R2 (S3-compatible) -----------------------------------------
# Cloudflare dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your-bucket-name
# Optional: public/custom domain for PUBLIC files only (use a separate bucket/prefix; private uploads never go public)
R2_PUBLIC_URL=
# Presigned URL lifetime in seconds (default 900 = 15 min)
R2_PRESIGN_EXPIRES_IN=900
# Upload limits: max size in bytes (default 25 MB) and comma-separated MIME allowlist (empty = default list:
# images, PDF, TXT, CSV, ZIP, DOCX, XLSX). Never allow text/html or image/svg+xml on a public bucket.
UPLOAD_MAX_BYTES=
UPLOAD_ALLOWED_TYPES=
# Per-user storage quota in bytes (ready files + uploads in progress). Default 1073741824 (1 GiB).
UPLOAD_QUOTA_BYTES=

# --- Stripe (OPTIONAL - leave empty to disable; /stripe/* then returns 503) --------------
# Stripe dashboard > Developers > API keys
STRIPE_SECRET_KEY=
# Developers > Webhooks > endpoint .../stripe/webhook > Signing secret. Events: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, customer.subscription.paused,
# customer.subscription.resumed, invoice.payment_failed
# (local dev: `stripe listen --forward-to localhost:3000/stripe/webhook`)
STRIPE_WEBHOOK_SECRET=
# Comma-separated price_... ids the checkout accepts (recommended; empty = any price in the account)
STRIPE_PRICE_IDS=
# Who pays: "user" (default, each user subscribes) or "org" (the active Clerk organization; only org admins manage)
BILLING_OWNER=user

# --- Ably (OPTIONAL - leave empty to disable; /realtime/* then returns 503) ---------------
# Ably dashboard > App > API Keys (format appId.keyId:keySecret). Server-only!
ABLY_API_KEY=

# --- Sentry (OPTIONAL - error monitoring) -------------------------------------
# Sentry > Project > Settings > Client Keys (DSN)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=

# --- Resend (OPTIONAL - transactional e-mail; without it e-mails are only logged)
RESEND_API_KEY=
# Must use a domain verified in Resend (onboarding@resend.dev only sends to your own address)
EMAIL_FROM=App <onboarding@resend.dev>
# Inbox for the public contact form (empty = only logged)
CONTACT_EMAIL=

# --- Upstash Redis (OPTIONAL - cache + rate limiting) --------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Upstash QStash (OPTIONAL - background jobs, retries, cron) ----------------
# Without it, jobs run inline. Local dev: `npx @upstash/qstash-cli dev` and set QSTASH_URL to it.
QSTASH_TOKEN=
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Public URL of this API (QStash calls ${API_PUBLIC_URL}/jobs/<name>)
API_PUBLIC_URL=

# --- PostHog (OPTIONAL - server-side analytics via trackEvent) ------------------
POSTHOG_KEY=
# https://us.i.posthog.com or https://eu.i.posthog.com
POSTHOG_HOST=https://us.i.posthog.com
# Feature flags on for everyone without PostHog (or if it fails), comma-separated: new-checkout,beta
FEATURE_FLAGS=
