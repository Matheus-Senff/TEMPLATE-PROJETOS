# --- Clerk (same application as the API) ---------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Site ------------------------------------------------------------------------
# Public URL of the site (canonical links, Open Graph, sitemap.xml, robots.txt)
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# --- API (apps/api) ------------------------------------------------------------
# The browser calls /api/* on this site; Next rewrites it to API_URL (server-side, read at BUILD time, one value
# per Vercel environment). Previews: https://<api-project>-git-{branch}-<team>.vercel.app ({branch} = Git branch).
API_URL=http://localhost:3000
# Server-only, same value as the API's API_PROXY_SECRET: /api calls carry the visitor IP signed with it.
API_PROXY_SECRET=
# Optional direct cross-origin mode (no proxy): absolute API URL; the API's CORS_ORIGINS must list this site.
NEXT_PUBLIC_API_URL=

# --- Cloudflare Turnstile (bot check on the contact form) ----------------------
# Site key of the Turnstile widget (the secret goes in apps/api). Test key (always passes): 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Content-Security-Policy (build time, see csp.ts) ---------------------------
# Origin the browser uploads to (presigned PUT): https://<bucket>.<account_id>.r2.cloudflarestorage.com
# Empty = any *.r2.cloudflarestorage.com (works, but set it in production to allow only your bucket).
R2_UPLOAD_ORIGIN=
# Public R2 domain, only if you serve public images/media from it (allowed in img-src/media-src)
R2_PUBLIC_URL=

# --- Stripe (OPTIONAL) - Price used by the demo checkout button ----------------
NEXT_PUBLIC_STRIPE_PRICE_ID=

# --- Sentry (OPTIONAL) - leave empty to disable --------------------------------
NEXT_PUBLIC_SENTRY_DSN=
# Source map upload (deploy only): Sentry > Settings > Auth Tokens
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- PostHog (OPTIONAL - product analytics) - leave empty to disable ------------
# PostHog > Project settings > Project API key (phc_...). Only starts after the visitor accepts the cookie banner (LGPD).
NEXT_PUBLIC_POSTHOG_KEY=
# "us" (default) or "eu" - must match your PostHog project region
NEXT_PUBLIC_POSTHOG_REGION=us
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
# Feature flags for signed-out visitors (signed-in users get GET /api/me/flags), comma-separated
NEXT_PUBLIC_FEATURE_FLAGS=

# --- E2E (Playwright, optional; usually GitHub secrets, not .env) ----------------
# Signed-in tests (e2e/auth) need a Clerk DEVELOPMENT instance and a running full stack (web + API + DB + R2).
E2E_BASE_URL=
E2E_CLERK_PUBLISHABLE_KEY=
E2E_CLERK_SECRET_KEY=
# Vercel > Settings > Deployment Protection > Protection Bypass for Automation (protected previews)
VERCEL_AUTOMATION_BYPASS_SECRET=
